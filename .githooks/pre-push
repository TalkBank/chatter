#!/usr/bin/env bash
#
# Refuse a push unless BOTH halves of `just gate` have passed on this tree.
#
# THIS HOOK RUNS NO CHECKS. It reads two stamps that only `just gate-fast` and
# `just gate-slow` write.
#
# # Why it does no work
#
# The obvious hook runs the gate. That fails two ways at once. The gate takes
# 12-15 minutes, and git has already opened its connection to the remote before
# the hook runs, so a slow hook is closed by GitHub's SSH idle timeout and the
# push fails AFTER passing. And a 15-minute hook manufactures pressure to use
# `--no-verify`, which this project forbids outright, so it would convert a
# real gate into a habitually bypassed one.
#
# # Why two stamps rather than one
#
# `gate` is `gate-fast` plus `gate-slow`, and on a cold build the pair exceeds
# a single command invocation's time ceiling, so the halves have to be
# runnable separately. The first version of this hook read ONE stamp that only
# the combined `gate` wrote, which meant running both halves did all the work
# and produced no proof: the split and the stamp were added an hour apart and
# nothing checked that one satisfied the other.
#
# Two stamps make the composition real. Running the halves is now equivalent to
# running `gate`, which is what the split claimed all along.
#
# # Why it exists at all
#
# The hook it replaces ran `fmt-check` and `actionlint` and printed
#
#     [pre-push] fast gate passed
#
# On 2026-08-12 that is precisely what happened: `git push` was typed, this
# hook fired, printed "gate passed", and let through a commit with a broken
# doctest and a 997-line stale `parser.c`. It was not that no hook stopped the
# push. A hook ran and issued a green, for two checks out of twenty, using the
# word "gate".
#
# So the rule is: a check that cannot run the gate must not report on it.
set -euo pipefail

# ORDER MATTERS: commit first, then gate, then push.
#
# The stamp records the WORKING TREE state, so committing changes it: a gate
# run before the commit stamps "these files are modified" and the push stamps
# "clean". That is correct rather than annoying, because it makes the stamp
# mean "the gate ran on exactly what you are pushing", which is the only claim
# worth having. Gate the thing you are about to push.
TREE_STATE="$(git status --porcelain | shasum | cut -d' ' -f1)"

for half in fast slow; do
    stamp=".git/gate-${half}-passed"
    if [ ! -f "$stamp" ]; then
        echo "[pre-push] REFUSED: no stamp from 'just gate-${half}'." >&2
        echo "           Run 'just push', or 'just gate-fast' and" >&2
        echo "           'just gate-slow' if a time ceiling forces the split." >&2
        exit 1
    fi
    got="$(cat "$stamp")"
    if [ "$got" != "$TREE_STATE" ]; then
        echo "[pre-push] REFUSED: the gate-${half} stamp is for a different tree." >&2
        echo "           stamped: $got" >&2
        echo "           pushing: $TREE_STATE" >&2
        exit 1
    fi
done

echo "[pre-push] both gate stamps match this tree."

# Chain to an optional local pre-push hook, AFTER the gate stamps, so a stamp
# failure short-circuits first and a contributor's own check never masks it.
#
# `core.hooksPath` points git at this directory, which means it ignores
# `.git/hooks` ENTIRELY: anything a contributor installed there stops running,
# silently. This is the seam that gives it back, and it is the same one
# `.githooks/pre-commit` offers.
#
# `exec`, not a call: git feeds pre-push its ref list on stdin, and execing
# hands that stream to the local hook unread rather than consuming it here.
#
# Keep this free of any specific local hook's identity. It is tracked and
# public; what an individual checks on their own machine is theirs.
LOCAL_HOOK="$(git rev-parse --git-dir)/hooks/pre-push.local"
if [ -x "$LOCAL_HOOK" ]; then
    exec "$LOCAL_HOOK" "$@"
fi
