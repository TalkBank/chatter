#!/usr/bin/env bash
#
# Refuse a push unless `just gate` has passed on this tree.
#
# THIS HOOK RUNS NO CHECKS. It reads one stamp that only `just gate` writes.
#
# # Why it does no work
#
# The obvious hook runs the gate. That fails two ways at once. Git has already
# opened its connection to the remote before the hook runs, so a slow hook is
# closed by GitHub's SSH idle timeout and the push fails AFTER passing. And a
# multi-minute hook manufactures pressure to use `--no-verify`, which this
# project forbids outright, so it would convert a real gate into a habitually
# bypassed one.
#
# # Why one stamp
#
# There were two, `gate-fast` and `gate-slow`, because the slow half exceeded a
# single command invocation's time ceiling on a cold build. That split existed
# to work around a gate that compiled the same code four or five times; clippy
# and the feature-off build moved to `just release-lint` and the remaining gate
# runs in one go, so the halves and their two stamps are gone. One gate, one
# stamp, one thing for this hook to check.
#
# # Why it exists at all
#
# The hook it replaces ran `fmt-check` and `actionlint` and printed
#
#     [pre-push] fast gate passed
#
# On 2026-08-12 that is precisely what happened: `git push` was typed, this
# hook fired, printed "gate passed", and let through a commit with a broken
# doctest and a 997-line stale `parser.c`. It was not that no hook stopped the
# push. A hook ran and issued a green, for two checks out of twenty, using the
# word "gate".
#
# So the rule is: a check that cannot run the gate must not report on it.
set -euo pipefail

# ORDER MATTERS: commit first, then gate, then push.
#
# The stamp records the WORKING TREE state, so committing changes it: a gate
# run before the commit stamps "these files are modified" and the push stamps
# "clean". That is correct rather than annoying, because it makes the stamp
# mean "the gate ran on exactly what you are pushing", which is the only claim
# worth having. Gate the thing you are about to push.
#
# `tree-stamp.sh` exits non-zero rather than printing an empty stamp; under
# `set -e` that aborts the push here, which is the point. Its first version
# printed nothing on failure and this hook then compared "" to "" and passed.
TREE_STATE="$(bash "$(git rev-parse --show-toplevel)/scripts/tree-stamp.sh")"

# `git rev-parse --git-dir`, never a literal `.git`: in a worktree `.git` is a
# file, and the gate writes its stamp to the same resolved directory.
stamp="$(git rev-parse --git-dir)/gate-passed"
if [ ! -f "$stamp" ]; then
    echo "[pre-push] REFUSED: no stamp from 'just gate'." >&2
    exit 1
fi
got="$(cat "$stamp")"
if [ "$got" != "$TREE_STATE" ]; then
    echo "[pre-push] REFUSED: the gate stamp is for a different tree." >&2
    echo "           stamped: $got" >&2
    echo "           pushing: $TREE_STATE" >&2
    exit 1
fi

echo "[pre-push] the gate stamp matches this tree."

# Chain to an optional local pre-push hook, AFTER the gate stamp, so a stamp
# failure short-circuits first and a contributor's own check never masks it.
#
# `core.hooksPath` points git at this directory, which means it ignores
# `.git/hooks` ENTIRELY: anything a contributor installed there stops running,
# silently. This is the seam that gives it back, and it is the same one
# `.githooks/pre-commit` offers.
#
# `exec`, not a call: git feeds pre-push its ref list on stdin, and execing
# hands that stream to the local hook unread rather than consuming it here.
#
# Keep this free of any specific local hook's identity. It is tracked and
# public; what an individual checks on their own machine is theirs.
LOCAL_HOOK="$(git rev-parse --git-dir)/hooks/pre-push.local"
if [ -x "$LOCAL_HOOK" ]; then
    exec "$LOCAL_HOOK" "$@"
fi
