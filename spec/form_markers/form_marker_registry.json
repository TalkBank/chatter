      "example_note": null,
      "label": "forbidden",
      "deprecated": {
        "use_instead": "&-um",
        "reason": "filled pauses are excluded from grammatical analysis"
      }
    },
    {
      "marker": "g",
      "variant": "G",
      "gloss": "General special form",
      "manual_anchor": "GeneralSpecialForm_Marker",
      "example_stem": "gongga",
      "example_note": null,
      "label": "forbidden"
    },
    {
      "marker": "i",
      "variant": "I",
      "gloss": "Interjection, interaction",
      "manual_anchor": "Interjection_Marker",
      "example_stem": "uhhuh",
      "example_note": null,
      "label": "forbidden"
    },
    {
      "marker": "k",
      "variant": "K",
      "gloss": "Multiple letters",
      "manual_anchor": "Kana_Marker",
