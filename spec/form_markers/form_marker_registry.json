      "label": "forbidden"
    },
    {
      "marker": "wp",
      "variant": "WP",
      "gloss": "Word play",
      "manual_anchor": "WordPlay_Marker",
      "example_stem": "goobarumba",
      "example_note": null,
      "label": "forbidden"
    },
    {
      "marker": "x",
      "variant": "X",
      "gloss": "Excluded words",
      "manual_anchor": "Excluded_Marker",
      "example_stem": "stuff",
      "example_note": null,
      "label": "forbidden",
      "manual_disagreement": "The manual's Letters column writes `@x:*`, implying a label, but its own Example column writes bare `stuff@x` and depfile.cut sanctions bare `*@x` beside `*@s:*` and `*@z:*`. `@x:foo` is rejected (E203); do not \"fix\" this to match the manual's table."
    },
    {
      "marker": "z",
      "variant": "UserDefined",
      "gloss": "User-defined code",
      "manual_anchor": "User_Special_Form",
      "example_stem": "word",
      "example_note": "any user code",
      "label": {
        "required": {
          "example_label": "rtfd"
        }
      }
    }
