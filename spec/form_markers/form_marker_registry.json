{
  "version": 1,
  "description": "Canonical inventory of CHAT special-form markers (the `@` suffix on a word)",
  "authorities": {
    "manual_table": "https://talkbank.org/0info/manuals/CHAT.html#Special_Form_Markers",
    "sanctioned_set": "clan-info/lib/depfile.cut, the main-line `*@...` entries",
    "note": "The manual gives MEANINGS; depfile.cut gives what is SANCTIONED and is the more current of the two. Where they disagree, depfile.cut wins and the disagreement is recorded on the row."
  },
  "markers": [
    {
      "marker": "b",
      "variant": "B",
      "gloss": "Babbling",
      "manual_anchor": "Babbling_Marker",
      "example_stem": "abame",
      "example_note": null,
      "label": "forbidden"
    },
    {
      "marker": "c",
      "variant": "C",
      "gloss": "Child-invented form",
      "manual_anchor": "ChildInvented_Marker",
      "example_stem": "gumma",
      "example_note": "meaning sticky",
      "label": "forbidden"
    },
    {
      "marker": "d",
      "variant": "D",
      "gloss": "Dialect form",
      "manual_anchor": "DialectForm_Marker",
      "example_stem": "younz",
      "example_note": "meaning you",
      "label": "forbidden"
    },
    {
      "marker": "f",
      "variant": "F",
      "gloss": "Family-specific form",
      "manual_anchor": "FamilySpecificForm_Marker",
      "example_stem": "bunko",
      "example_note": "meaning broken",
      "label": "forbidden"
    },
    {
      "marker": "fp",
      "variant": "FP",
      "gloss": "Filled pause",
      "manual_anchor": "FilledPause_Marker",
